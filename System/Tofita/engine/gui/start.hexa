class Widget {
	var title String
	var content String
	var color Pixel32
	var width UInt16
	var height UInt16
	new() {}
}

let startWidgets [Widget] = []

fun updateTimeWidget(widget Widget) {
	// Simple placeholder using uptime as CMOS read is complex for this turn
	let seconds = uptimeMilliseconds / 1000
	let mins = (seconds / 60) % 60
	let hours = (seconds / 3600) % 24
	widget.content = hours + ":" + (mins < 10 ? "0" : "") + mins
}

class StartMenu {
	static fun drawWidgets(x Int16, y Int16, w Int16, h Int16) Void {
		// Update dynamic widgets
		for i in startWidgets.length {
			let widget = startWidgets[i]
			if widget.title == "System" {
				widget.content = "CPUs: " + ACPIParser.coresAp + " RAM: " + (PhysicalAllocator.available * 4096 / 1024 / 1024) + "MB"
			} else if widget.title == "Clock" {
				updateTimeWidget(widget)
			}
		}
		let pad = 12i16
		var xu = x + pad
		var yu = y + pad

		for i in startWidgets.length {
			let widget = startWidgets[i]

			// Glassy widget background
			drawVibrancedRectangleRounded(xu, yu, widget.width, widget.height, 12, true)

			let color = new ByValue<Pixel32>()
			color.ref.color = 0xFFFFFFFFu32
			drawTextBox(widget.title, xu + 8i16, yu + 8i16, color.ref, widget.width - 16u16, 20, true)

			color.ref.color = 0xAAAAAAAAu32
			drawTextBox(widget.content, xu + 8i16, yu + 28i16, color.ref, widget.width - 16u16, widget.height - 32u16, true)

			xu += widget.width as! Int16 + pad
			if xu + widget.width as! Int16 > x + w {
				xu = x + pad
				yu += widget.height as! Int16 + pad
			}

			if yu + widget.height as! Int16 > y + h {
				break
			}
		}
	}

	// TODO scrollOffsetY Int16
	/// Render the pinned apps and files
	static fun drawPinnedItems(x Int16, y Int16, w Int16, h Int16) Void {
		let yOffset = 12i16 + 48i16 + 10i16 + 4i16 + 16i16
		let startX = 10 + x
		var xu = startX
		var yu = 12 + y
		let color = new ByValue<Pixel32>()

		color.ref.rgba.ref.a = 100
		color.ref.rgba.ref.r = color.ref.rgba.ref.g = color.ref.rgba.ref.b = 0x61u8
		let hoverColor = color
		let holdColor = color
		holdColor.ref.rgba.ref.a = 64

		// TODO draw =P when zero pinned and show built-in apps in recommendations
		for i in startShortcuts.length {
			let shortcut = startShortcuts[i]
			let rectangle = shortcut.rectangle

			rectangle.relativeX = xu - x
			rectangle.relativeY = yu - 2 + 24 - y
			rectangle.width = 76i16
			rectangle.height = 78i16

			if rectangle.mouseOver {
				drawRectangleWithAlpha(
					rectangle.mouseHold? holdColor.ref : hoverColor.ref,
					x + rectangle.relativeX,
					y - 25 + rectangle.relativeY,
					rectangle.width + 0u16,
					rectangle.height + 0u16
				)
			}

			drawBitmap32WithAlpha(shortcut.icon, 14i16 + xu, yu)

			color.ref.color = 0x00000000
			let shadowTextWidth = 76u16 - 8u16
			let textX = 2 + xu
			color.ref.rgba.ref.r = color.ref.rgba.ref.g = color.ref.rgba.ref.b = 0xFFu8
			drawShadowText(shortcut.displayName, textX, 62i16 + yu, shadowTextWidth, color.ref)

			// Grid
			xu += yOffset

			if xu + yOffset > x + w {
				xu = startX
				yu += yOffset
			}

			let padding = 16i16
			if (yu + padding) > y + h {
				break
			}
		}
	}
}
